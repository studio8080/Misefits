# Price ID は秘匿情報ではないため（公開されても悪用できない）、シークレットではなく通常の
# 環境変数として管理する。誤発行防止用のチェックに使われる（functions/index.js の stripePriceId）。
# テストモードと本番モードで別のIDになる点に注意。本番公開時は本番モードのPrice IDに差し替えること。
STRIPE_PRICE_ID=price_1U9KMg3C6tqke0fyB4wtmO3T

# ライセンスキーの控えメール送信用（任意）。ここに置くのは非個人情報だけ。
# 差出人アドレス（SMTP_USER / MAIL_FROM）とパスワード（SMTP_PASS）は Secret Manager に入れる。
# このリポジトリは公開なので、メールアドレスをこのファイルに書かないこと。
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set MAIL_FROM
#   firebase functions:secrets:set SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ---- MenuFits（menufits.kokokikaku.com）の買い切り販売 ----
# MiseFits とは別売り。関数・コレクション・Webhook・シークレットをすべて分けている。
# 本番（ライブ）モードの Price ID（2026-09-01 切替）。
# 検証時に使ったサンドボックスの Price ID は price_1UAniYKwklnRvDMqKN1SK2ob だった。
# シークレット2件もライブ用に差し替えること（サンドボックスの鍵ではライブのセッションを読めない）。
#   firebase functions:secrets:set STRIPE_SECRET_KEY_MENUFITS      # sk_live_...
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET_MENUFITS  # we_1UAonw3C6tqke0fyWyolaZ15 の whsec_...
STRIPE_PRICE_ID_MENUFITS=price_1UAoj83C6tqke0fyiXZcqMtG

# ---- Lemon Squeezy（英語版・海外向けの MiseFits Pro 販売） ----
# 商品の Product ID（数字）。ストアで商品を作ったら入れる。違うIDのままだと購入が成立してもキーが出ない。
# 空のあいだはどの商品の注文でもキーを発行する（素通し）ので、本番販売の前に必ず埋めること。
LEMONSQUEEZY_PRODUCT_ID=
# テストモードの注文でもキーを出すか。検証のあいだだけ true にし、本番販売の前に false へ戻してデプロイする。
LEMONSQUEEZY_ALLOW_TEST=false
# 署名用シークレットは Secret Manager 側（.env には書かない）：
#   firebase functions:secrets:set LEMONSQUEEZY_WEBHOOK_SECRET --project misefits
